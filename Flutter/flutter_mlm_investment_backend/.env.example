# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Environment (local, staging, production)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/flutter_mlm_investment_backend

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flutter_mlm_investment
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production-use-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY=300
OTP_PROVIDER=test

# SMS Provider Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMS Provider Configuration (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4

# SMS Provider Configuration (2Factor)
TWOFACTOR_API_KEY=

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# Wallet Configuration
MIN_WITHDRAWAL_AMOUNT=100
WITHDRAWAL_CHARGE_PERCENTAGE=2
MAX_DAILY_WITHDRAWAL=50000

# Investment Configuration
MIN_INVESTMENT_AMOUNT=1000
MAX_INVESTMENT_AMOUNT=1000000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
TIMEZONE=Asia/Kolkata

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
