# Production Environment Configuration
# Copy this to .env on your production server and update with actual values

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com/api

# Database Configuration
DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=your_production_db_name
DB_USER=your_production_db_user
DB_PASS=your_production_db_password
DB_CHARSET=utf8mb4

# JWT Configuration (IMPORTANT: Generate a strong random key!)
# You can generate one using: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-64-CHARACTER-STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY=300
OTP_PROVIDER=msg91

# SMS Provider Configuration (MSG91 - Recommended for India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=your_sender_id
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_ROUTE=4

# Alternative: Twilio Configuration
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Alternative: 2Factor Configuration
# TWOFACTOR_API_KEY=your_2factor_api_key

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# Wallet Configuration
MIN_WITHDRAWAL_AMOUNT=100
WITHDRAWAL_CHARGE_PERCENTAGE=2
MAX_DAILY_WITHDRAWAL=50000

# Investment Configuration
MIN_INVESTMENT_AMOUNT=1000
MAX_INVESTMENT_AMOUNT=1000000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
TIMEZONE=Asia/Kolkata

# CORS Configuration (Update with your Flutter app domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
